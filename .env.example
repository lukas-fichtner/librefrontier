# LibreFrontier environment variables
# Copy to .env and adjust

# Gin mode: release or debug
GIN_MODE=release

# Exposed host ports
API_PORT=80
GUI_PORT=8080

# Public base URL (include protocol, no trailing slash)
LF_API_BASE_URL=http://localhost

# PostgreSQL connection string
LF_DB_CONN_STRING=postgres://librefrontier:librefrontier@postgres:5432/librefrontier?sslmode=disable
